APP_NAME=AerMusic
APP_ENV=development
HOST=127.0.0.1
PORT=5008

DATABASE_PATH=data/aermusic.db
SESSION_TTL_SECONDS=2592000

# 数据库后端 auto=优先 PostgreSQL(连不上自动降级本地 sqlite), 也可填 sqlite/pg 强制指定
DB_BACKEND=auto
# PostgreSQL 地址填 host:port(裸 host 默认 5432, IPv6 写 [::1]:5432), 留空则只用 sqlite
PGSQL_URL=
PGSQL_USERNAME=
PGSQL_PASSWORD=
# 库不存在时会用同账号连 postgres 库自动建, 不迁移旧 sqlite 数据
PGSQL_DATABASE=
PGSQL_POOL_MIN=2
PGSQL_POOL_MAX=16
PGSQL_CONNECT_TIMEOUT=5
# production 会按 APP_ENV 默认开启 Secure, 也可显式覆盖; 本地 HTTP 保持 false
SESSION_COOKIE_SECURE=False

# 网易云上游服务地址
# 若这两个地址是 localhost/127.0.0.1/内网(如与 AerMusic 同机部署), 构建时前端会自动改为走本站 /api/up 与 /api/upl 代理, 不再让浏览器直连上游
NETEASE_API_BASE=https://163.aermini.top
NETEASE_LYRIC_BASE=https://api.music.aermini.top/tr/lyric

NETEASE_URL_API=http://localhost:5000/geturl
NETEASE_URL_KEY= # geturl 服务的 key. 此处由于个人项目用了自己的服务, 所以加了这个配置.

UPSTREAM_TIMEOUT=10
UPSTREAM_RETRIES=2
UPSTREAM_MAX_RESPONSE_BYTES=4194304

# 内网模式下 /api/up 代理端点的进程内缓存秒数(0=不缓存), 只影响构建时被判定为内网的那几个上游接口
UP_PROXY_TTL=120

# true 时前端取推荐/心动模式直接走 GET /api/recommend/get(后端结合用户画像与收藏歌单实时算), 不再走前端推荐逻辑
INTERNAL_RECOMMEND=false

# 日志队列和单日日志轮转上限
LOG_QUEUE_MAX=50000
LOG_MAX_BYTES=20971520
LOG_MAX_FILES=5

# 可选 Redis/Garnet, 配置后优先用于推荐事件共享限流, 连接失败自动回退进程内限流
# ADDRESS 填 host:port, 密码留空表示无认证, 多 worker 部署建议配; Redis 配置后连接故障会闭锁限流请求
REDIS_ADDRESS=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=0.3
REDIS_RETRY_SECONDS=30
REDIS_RATE_PREFIX=aermusic:recommend:rate:

# 缓存
CACHE_DEFAULT=300
CACHE_MAX_ENTRIES=800
CACHE_MAX_BYTES=67108864
MAX_LIMIT=100
# 部署版本号(静态资源缓存击穿), 默认取启动时间戳, 一般不用填
# APP_VERSION=

# 逗号分隔
# 反向代理/EdgeOne 的回源地址或网段; 只有命中这里的连接才会采信 X-Client-RealIP0/XFF
TRUSTED_PROXIES=127.0.0.1,::1
CORS_ALLOWED_ORIGINS=

# 邮箱验证码 SMTP, 开发环境如需日志验证码请显式打开 SMTP_DEV_LOG_CODE
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_SSL=True
# 验证码有效期(秒)与同邮箱重发冷却(秒)
SMTP_CODE_TTL=300
EMAIL_SEND_COOLDOWN=90
SMTP_DEV_LOG_CODE=false

# 头像 OSS 直传: 填 CCW 账号的 token 与 user_id 后, 头像走 OSS 并返回 CDN 直链; 留空则落本地 data/avatars
CCW_OSS_TOKEN=
CCW_OSS_USER_ID=
CCW_OSS_BUCKET=zhishi
CCW_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
CCW_OSS_CDN=m.ccw.site
CCW_OSS_PREFIX=uploads

# OIDC IdP, 白名单里的站点可用 AerMusic 账号登录
OIDC_ENABLED=True
# 发行者地址, 默认取 CORS 第一个来源或 http://HOST:PORT, 无尾斜杠
OIDC_ISSUER=
# Ed25519 密钥 PEM 存放目录与 kid
OIDC_KEY_DIR=data/oidc_keys
OIDC_KID=oidc_1
OIDC_CODE_TTL_SECONDS=120
OIDC_ACCESS_TTL_SECONDS=1800
OIDC_ID_TTL_SECONDS=1800
OIDC_REFRESH_TTL_SECONDS=2592000
OIDC_CONSENT_TTL_SECONDS=600
# 客户端白名单 JSON: {"client_id":{"name","secret","redirects":["https://app/callback"],"scopes":["openid","profile"],"token_endpoint_auth_method":"client_secret_basic"}}
# secret 支持明文或 sha256$hex; 无 secret 的条目视为 public client(仅 PKCE, 不发 refresh_token)
OIDC_CLIENTS={}
