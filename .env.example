# 复制为 .env 后按需修改, 全部都有默认值, 不填也能跑
APP_NAME=AerMusic
HOST=127.0.0.1
PORT=5008

DATABASE_PATH=data/aermusic.db
SESSION_TTL_SECONDS=2592000
# HTTPS 公网部署必须改为 True, 否则会话 Cookie 可经明文 HTTP 泄露
SESSION_COOKIE_SECURE=True

# 网易云上游服务地址
NETEASE_API_BASE=http://localhost:3000
NETEASE_LYRIC_BASE=http://localhost:5000/tr/lyric
NETEASE_URL_API=http://localhost:5000/geturl
# geturl 服务的 key, 必填, 不再写死在代码里
NETEASE_URL_KEY=

UPSTREAM_TIMEOUT=10
UPSTREAM_RETRIES=2

# 可选 Redis/Garnet, 配置后优先用于推荐事件共享限流, 连接失败自动回退进程内限流
# ADDRESS 填 host:port, 密码留空表示无认证, 多 worker 部署建议配
REDIS_ADDRESS=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=0.3
REDIS_RETRY_SECONDS=30
REDIS_RATE_PREFIX=aermusic:recommend:rate:

CACHE_DEFAULT=300
CACHE_MAX_ENTRIES=800
MAX_LIMIT=100
# 部署版本号(静态资源缓存击穿), 默认取启动时间戳, 一般不用填
# APP_VERSION=

TRUSTED_PROXIES=127.0.0.1,::1
CORS_ALLOWED_ORIGINS=
